# Copy this file to ".env" in the same folder and fill in real values.
# .env is git-ignored, so credentials never reach GitHub.
# Every service loads it automatically (spring.config.import).

# --- Security (REQUIRED) ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=480
# Shared key for service-to-service calls on /internal/** (any long random string)
INTERNAL_API_KEY=replace-with-another-long-random-string

# Password given to the demo users created on first start of auth-service
# (letters and digits, at least 8 characters). Change it for anything beyond local demos.
SEED_DEFAULT_PASSWORD=Dpdms@2026

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=dpdms
DB_PASSWORD=replace-me

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Email (defaults point at Mailpit from docker-compose; use Gmail/SendGrid SMTP in production) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=alerts@dpdms.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# --- WhatsApp Business Cloud API ---
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Service discovery / gateway ---
EUREKA_URL=http://localhost:8761/eureka
GATEWAY_URL=http://localhost:8080

# --- Feature flags (handy when RabbitMQ or SMTP are not available) ---
# false = hazard services skip publishing alert events (incidents still save normally)
ALERTS_ENABLED=true
# false = alert-service logs the email instead of sending it, and records SKIPPED
MAIL_ENABLED=true

# --- Port overrides (only needed if something else already uses a default port) ---
DISCOVERY_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8081
FLOOD_PORT=8082
DROUGHT_PORT=8083
FIRE_PORT=8084
ZOONOTIC_PORT=8085
MINING_PORT=8086
ALERT_PORT=8087
REPORT_PORT=8088
DASHBOARD_PORT=8089
WEB_UI_PORT=8090
